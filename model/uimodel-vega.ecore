<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmlns:xmi="http://www.omg.org/XMI" xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="uimodel.vega" nsURI="http://uimodel/vega/1.0" nsPrefix="uivega">

  <!-- ================================================================ -->
  <!-- VegaView — Top-Level Component                                   -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaView">
    <eSuperTypes href="http://uimodel/1.0#//Component"/>
    <!-- Visualisierungsinhalt (Unit, Layer oder Composition) -->
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="#//VegaSpec" name="content" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="#//VegaDataSource" name="dataSource" containment="true"/>
    <!-- Selection-Parameter (Point, Interval) -->
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="#//VegaParam" name="params" containment="true"/>
    <!-- Signal-Bindings zurueck ins EMF-Modell -->
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="#//VegaSignalBinding" name="signals" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="title"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="width"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="height"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaAutosize" name="autosize" defaultValueLiteral="PAD"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="padding"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="background"/>
    <!-- Escape-Hatch: statische Vega-Lite JSON-Spec -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="spec"/>
    <!-- Escape-Hatch: dynamische Spec via Expression (Kontext: EObject). Vorrang vor spec. -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://uimodel/1.0#//Expression" name="specExpression" containment="true"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaSpec — Composition-Hierarchie                                -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaSpec" abstract="true">
    <!-- Transforms gelten fuer alle Spec-Typen -->
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="#//VegaTransform" name="transforms" containment="true"/>
  </eClassifiers>

  <!-- Einzelnes Diagramm: ein Mark + Encodings -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaUnitSpec">
    <eSuperTypes href="#//VegaSpec"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="#//VegaMarkDef" name="mark" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="#//VegaEncoding" name="encodings" containment="true"/>
  </eClassifiers>

  <!-- Mehrere Marks uebereinander (z.B. Line + Point) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaLayerSpec">
    <eSuperTypes href="#//VegaSpec"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1" upperBound="-1"
        eType="#//VegaSpec" name="layers" containment="true"/>
    <!-- Shared Encodings fuer alle Layer -->
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="#//VegaEncoding" name="encodings" containment="true"/>
  </eClassifiers>

  <!-- Horizontale Anordnung -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaHConcatSpec">
    <eSuperTypes href="#//VegaSpec"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1" upperBound="-1"
        eType="#//VegaSpec" name="specs" containment="true"/>
  </eClassifiers>

  <!-- Vertikale Anordnung -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaVConcatSpec">
    <eSuperTypes href="#//VegaSpec"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1" upperBound="-1"
        eType="#//VegaSpec" name="specs" containment="true"/>
  </eClassifiers>

  <!-- Small Multiples: aufgeteilt nach einem Feld -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaFacetSpec">
    <eSuperTypes href="#//VegaSpec"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="facetField"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="#//VegaFieldType" name="facetFieldType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="columns"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaSortOrder" name="facetSort" defaultValueLiteral="ASCENDING"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="#//VegaSpec" name="spec" containment="true"/>
  </eClassifiers>

  <!-- Wiederholung mit verschiedenen Feldern -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaRepeatSpec">
    <eSuperTypes href="#//VegaSpec"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="fields"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="columns"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="#//VegaSpec" name="spec" containment="true"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaMarkDef — Mark-Konfiguration                                 -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaMarkDef">
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="#//VegaMarkType" name="type"/>
    <!-- Visuelle Eigenschaften -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="opacity"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="filled"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="color"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="fill"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="stroke"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="strokeWidth"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="cornerRadius"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaInterpolate" name="interpolate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="size"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="clip"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="cursor"/>
    <!-- Line/Area-spezifisch -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="point"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="line"/>
    <!-- Arc-spezifisch -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="innerRadius"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="outerRadius"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="padAngle"/>
    <!-- Bar-spezifisch -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaOrientation" name="orient"/>
    <!-- Text-spezifisch -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="fontSize"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="fontWeight"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="font"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaAlign" name="align"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaBaseline" name="baseline"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="dx"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="dy"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="angle"/>
    <!-- Tooltip -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="tooltip"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaEncoding — Kanal-Encoding                                    -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaEncoding">
    <!-- Welcher Kanal (x, y, color, size, ...) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="#//VegaChannel" name="channel"/>
    <!-- Datenbindung: Feature oder Expression (expression hat Vorrang) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="feature"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://uimodel/1.0#//Expression" name="expression" containment="true"/>
    <!-- Fester Wert statt Feld-Bindung (z.B. color = "red") -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="value"/>
    <!-- Datentyp und Aggregation -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="#//VegaFieldType" name="fieldType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaAggregate" name="aggregate" defaultValueLiteral="NONE"/>
    <!-- Binning -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="bin"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="binStep"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="binMaxBins"/>
    <!-- Zeiteinheit -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaTimeUnit" name="timeUnit"/>
    <!-- Beschriftung und Format -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="title"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="format"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="formatType"/>
    <!-- Sortierung -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaSortOrder" name="sort"/>
    <!-- Stacking -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaStack" name="stack"/>
    <!-- Band-Position (0..1, fuer Band-Scales) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="bandPosition"/>
    <!-- Scale, Axis, Legend Konfiguration -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="#//VegaScale" name="scale" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="#//VegaAxis" name="axis" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="#//VegaLegend" name="legend" containment="true"/>
    <!-- Conditional Encoding (z.B. Farbe abhaengig von Selection) -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="#//VegaCondition" name="condition" containment="true"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaScale                                                        -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaScale">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaScaleType" name="type" defaultValueLiteral="LINEAR"/>
    <!-- Domain (Eingabebereich) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="domain"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://uimodel/1.0#//Expression" name="domainExpression" containment="true"/>
    <!-- Range (Ausgabebereich) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="range"/>
    <!-- Farbschema (z.B. "category10", "blues", "viridis") -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="scheme"/>
    <!-- Scale-Verhalten -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="zero"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="nice"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="clamp"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="round"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="reverse"/>
    <!-- Band/Point-Scales -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="padding"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="paddingInner"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="paddingOuter"/>
    <!-- Log/Pow-Scales -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="exponent"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="base"/>
    <!-- Interpolation (fuer Farbskalen) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="interpolate"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaAxis                                                         -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaAxis">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaAxisOrient" name="orient"/>
    <!-- Titel -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="title"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="titleAngle"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="titleColor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="titleFontSize"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="titleFont"/>
    <!-- Labels -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="labels"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="labelAngle"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="labelColor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="labelFontSize"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="labelFont"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaLabelOverlap" name="labelOverlap"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="format"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="formatType"/>
    <!-- Grid -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="grid"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="gridColor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="gridOpacity"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="gridWidth"/>
    <!-- Ticks -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="ticks"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="tickCount"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="tickSize"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="tickColor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="tickWidth"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="values"/>
    <!-- Domain-Linie -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="domainLine"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="domainColor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="domainWidth"/>
    <!-- Layout -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="offset"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="minExtent"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="maxExtent"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="zindex"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaLegend                                                       -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaLegend">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaLegendOrient" name="orient"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="title"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="titleColor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="titleFontSize"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaLegendType" name="type"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaDirection" name="direction"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="labelColor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="labelFontSize"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="symbolSize"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="symbolType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="padding"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="offset"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="columns"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="values"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="disable"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaCondition — Conditional Encoding                             -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaCondition">
    <!-- Name des Selection-Parameters -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="param"/>
    <!-- Alternativ: Praedikat-Expression -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://uimodel/1.0#//Expression" name="predicate" containment="true"/>
    <!-- Wert wenn Bedingung true -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="value"/>
    <!-- Alternativ: Feld-basiertes Encoding wenn Bedingung true -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="feature"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaFieldType" name="fieldType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaAggregate" name="aggregate"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaParam — Selection/Parameter                                  -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaParam" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="name"/>
  </eClassifiers>

  <!-- Punkt-Selektion (Klick auf Datenpunkt) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaPointParam">
    <eSuperTypes href="#//VegaParam"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="fields"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="toggle"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="nearest"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="on"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="clear"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="#//VegaChannel" name="encodings"/>
  </eClassifiers>

  <!-- Intervall-Selektion (Brush/Zoom) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaIntervalParam">
    <eSuperTypes href="#//VegaParam"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="#//VegaChannel" name="encodings"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="#//VegaSelectionMark" name="mark" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="on"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="clear"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="translate"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EBoolean" name="zoom"
        defaultValueLiteral="true"/>
  </eClassifiers>

  <!-- Visuelles Styling der Intervall-Selektion -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaSelectionMark">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="fill"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="fillOpacity"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="stroke"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="strokeWidth"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaDataSource                                                   -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaDataSource">
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="feature"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://uimodel/1.0#//Expression" name="filterExpression" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="#//VegaTransform" name="transforms" containment="true"/>
    <!-- Escape-Hatch: JS-Expression die EList → Array mapped. Vorrang vor transforms. -->
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://uimodel/1.0#//Expression" name="transformExpression" containment="true"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaSignalBinding                                                -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaSignalBinding">
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="signalName"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="targetFeature"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://uimodel/1.0#//Expression" name="transform" containment="true"/>
  </eClassifiers>

  <!-- ================================================================ -->
  <!-- VegaTransform — Datentransformationen                            -->
  <!-- ================================================================ -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaTransform" abstract="true"/>

  <!-- Wide → Long -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaFoldTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="fields"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
  </eClassifiers>

  <!-- Gruppierung und Aggregation -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaAggregateTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="groupBy"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="#//VegaAggregate" name="op"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="field"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
  </eClassifiers>

  <!-- Berechnetes Feld via Expression -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaCalculateTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://uimodel/1.0#//Expression" name="calculate" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
  </eClassifiers>

  <!-- Binning -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaBinTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="field"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="maxBins"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="step"/>
  </eClassifiers>

  <!-- Zeiteinheit-Extraktion -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaTimeUnitTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="field"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="#//VegaTimeUnit" name="timeUnit"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
  </eClassifiers>

  <!-- Filter via Expression -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaFilterTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://uimodel/1.0#//Expression" name="filter" containment="true"/>
  </eClassifiers>

  <!-- Window-Funktionen (Rank, Running Total, etc.) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaWindowTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="#//VegaWindowOp" name="op"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="field"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="groupBy"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        eType="#//VegaSortField" name="sort" containment="true"/>
    <!-- Frame: [start, end] relativ zum aktuellen Datenpunkt. null = unbegrenzt -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="frameStart"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="frameEnd"/>
  </eClassifiers>

  <!-- Lookup (Join mit anderer Datenquelle) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaLookupTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="lookup"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="#//VegaLookupData" name="from" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="default"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="VegaLookupData">
    <!-- Collection-Feature das als Lookup-Tabelle dient -->
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="feature"/>
    <!-- Schluesselfeld in der Lookup-Tabelle -->
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="key"/>
    <!-- Felder die uebernommen werden -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="fields"/>
  </eClassifiers>

  <!-- Flatten (verschachtelte Arrays aufloesen) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaFlattenTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="fields"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
  </eClassifiers>

  <!-- Pivot (Long → Wide) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaPivotTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="pivot"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="value"/>
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="groupBy"/>
  </eClassifiers>

  <!-- Stichprobe -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaSampleTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="sample"/>
  </eClassifiers>

  <!-- Dichteverteilung (KDE) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaDensityTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="field"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EDouble" name="bandwidth"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EInt" name="steps"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
  </eClassifiers>

  <!-- Regression -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaRegressionTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="on"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="regression"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaRegressionMethod" name="method" defaultValueLiteral="LINEAR"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
  </eClassifiers>

  <!-- Imputation (fehlende Werte fuellen) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaImputeTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="impute"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="key"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaImputeMethod" name="method" defaultValueLiteral="VALUE"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="value"/>
  </eClassifiers>

  <!-- JoinAggregate (Aggregat ohne Reduktion) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaJoinAggregateTransform">
    <eSuperTypes href="#//VegaTransform"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="#//VegaAggregate" name="op"/>
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="field"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EString" name="as"/>
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="groupBy"/>
  </eClassifiers>

  <!-- Sortierfeld (fuer Window-Transform) -->
  <eClassifiers xsi:type="ecore:EClass" name="VegaSortField">
    <eStructuralFeatures xsi:type="ecore:EReference" lowerBound="1"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature" name="field"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        eType="#//VegaSortOrder" name="order" defaultValueLiteral="ASCENDING"/>
  </eClassifiers>

