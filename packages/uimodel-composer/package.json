{
  "name": "@emfts/uimodel-composer",
  "version": "0.0.2-next.1",
  "type": "module",
  "description": "UIModel-driven Vue 3 composer for EMF.ts models",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./css": {
      "import": "./dist/css/index.js",
      "types": "./dist/css/index.d.ts"
    }
  },
  "files": [
    "dist",
    "model"
  ],
  "scripts": {
    "generate": "emfts-codegen generate -m model/uimodel.ecore -c model/uimodel.genconfig.xmi",
    "generate:css": "emfts-codegen generate -m model/uimodel-css.ecore -c model/uimodel-css.genconfig.xmi -d model/uimodel.ecore --import-mapping http://uimodel/1.0=..",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@emfts/core": "^0.1.1-next.16",
    "@emfts/vue-registry": "^0.0.1-next.1"
  },
  "devDependencies": {
    "@emfts/codegen": "^0.0.1-next.7",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^4.1.4",
    "vue": "^3.4.0",
    "vue-tsc": "^3.2.4"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {},
  "keywords": [
    "emf",
    "ecore",
    "vue",
    "uimodel",
    "model-driven",
    "emfts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "EPL-2.0"
}
