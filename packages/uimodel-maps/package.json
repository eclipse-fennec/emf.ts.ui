{
  "name": "@emfts/uimodel-maps",
  "version": "0.0.1-next.1",
  "type": "module",
  "description": "OpenLayers maps for @emfts/uimodel-composer (MapView extension EPackage + renderer, QGIS-oriented)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "model"
  ],
  "scripts": {
    "generate": "emfts-codegen generate -m model/uimodel-maps.ecore -c model/uimodel-maps.genconfig.xmi -d ../uimodel-composer/model/uimodel.ecore --import-mapping http://uimodel/1.0=@emfts/uimodel-composer",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@emfts/core": "^0.1.1-next.16",
    "@emfts/uimodel-composer": "^0.0.2-next.1",
    "ol": "^10.9.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@emfts/codegen": "^0.0.1-next.7",
    "@vitejs/plugin-vue": "^5.0.0",
    "ol": "^10.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vue": "^3.4.0",
    "vue-tsc": "^3.2.4"
  },
  "keywords": [
    "emf",
    "ecore",
    "vue",
    "uimodel",
    "openlayers",
    "maps",
    "gis",
    "emfts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "EPL-2.0"
}
