{
  "name": "@emfts/tsrouter",
  "version": "0.1.0",
  "description": "Orthogonal graph router — calculates right-angle paths between nodes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "graph",
    "routing",
    "orthogonal",
    "diagram",
    "layout"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eclipse-fennec/emf.ts.ui.git",
    "directory": "packages/tsrouter"
  }
}
